APP_NAME="GarudaCBT Rebuild"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garudacbt
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_COOKIE_NAME=garudacbt_session

